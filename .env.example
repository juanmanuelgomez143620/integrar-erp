# Copiar como .env.local y completar. Este archivo NO debe contener valores reales.
# Cada instancia (escuela) tiene sus propios valores, cargados en su sitio de hosting.
# Los datos de la escuela (nombre, logo) NO van acá: viven en la tabla school_settings.
#
# Frontend (Vite): sólo claves PÚBLICAS.
# Nunca poner aquí la clave secreta (ex service_role): vive sólo en las Edge Functions.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dominio sintético para convertir el nombre de usuario en el email de Supabase Auth.
# Se define en el spike S-01 (ver MVP.md §11).
VITE_AUTH_EMAIL_DOMAIN=
